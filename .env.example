DATABASE_URL=postgresql://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@127.0.0.1:5432/projecthub
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=http://127.0.0.1:3000
APP_URL=http://127.0.0.1:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Vine Iternational Christian Academy ProjectHub <notifications@projecthub.local>
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SCAN_URL=
SCAN_TOKEN=
CRON_SECRET=replace-with-another-random-secret
ANALYTICS_SECRET=replace-with-another-random-secret

TRUST_PROXY=false
POSTGRES_PASSWORD=

# Required only for local seed; choose your own password, never use in production.
DEV_SEED_PASSWORD=
VERIFICATION_TTL_SECONDS=600
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_SECONDS=60
SESSION_TTL_SECONDS=604800
PROJECT_STORAGE_LIMIT_BYTES=262144000
BACKUP_DIRECTORY=.data/backups
# 32 random bytes as 64 hex characters; required for production backup command.
BACKUP_ENCRYPTION_KEY=
